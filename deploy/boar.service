[Unit]
Description=Boar BBS (telnet and SSH)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=boar
Group=boar
WorkingDirectory=/var/lib/boar
EnvironmentFile=-/etc/boar/boar.env
ExecStart=/opt/boar/bin/boar \
  -telnet :23 \
  -ssh :2222 \
  -name "Boar BBS" \
  -data /var/lib/boar/boar.db \
  -host-key /var/lib/boar/ssh_host_ed25519_key \
  -art /var/lib/boar/art \
  -doors /etc/boar/doors.json \
  -doors-dir /var/lib/boar/doors \
  -public-address boar.rh1.tech:2222 \
  $BOAR_ARGS
Restart=on-failure
RestartSec=5

# Port 23 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/boar
UMask=0077

[Install]
WantedBy=multi-user.target
