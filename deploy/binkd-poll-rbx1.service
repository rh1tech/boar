[Unit]
Description=Poll the relay (2:5030/1651.1 on rbx1) for FidoNet mail
After=network-online.target binkd.service
Wants=network-online.target

[Service]
Type=oneshot
User=ftn
Group=ftn
# -p: one-shot client; -P: force poll even with an empty outbound.
ExecStart=/usr/sbin/binkd -p -P2:5030/1651.1 /etc/binkd/binkd.cfg
Nice=10
