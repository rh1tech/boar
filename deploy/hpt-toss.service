[Unit]
Description=hpt: toss mail for point 2:5030/1651.1 and export it to the uplinks
After=binkd.service

[Service]
Type=oneshot
User=ftn
Group=ftn
Environment=FIDOCONFIG=/etc/husky/config
# afix answers robot requests left in the netmail area; it takes optional
# arguments, so it runs on its own.
ExecStart=/usr/local/bin/hpt toss
ExecStart=/usr/local/bin/hpt afix
ExecStart=/usr/local/bin/hpt scan pack
Nice=10
